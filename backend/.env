PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/rural_empowerment
JWT_SECRET=super_secret_jwt_key_for_rural_portal_2026
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_key_for_rural_portal_2026
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@digitalindiarural.com
FROM_NAME="Digital India Rural Portal"
